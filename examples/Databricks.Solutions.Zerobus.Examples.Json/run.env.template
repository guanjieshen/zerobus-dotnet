# Copy this file to run.env (which is gitignored) and fill in your values.
# Then run:   set -a; source run.env; set +a; dotnet run
#
# Zerobus gRPC endpoint (no scheme), e.g. <workspace-id>.zerobus.<region>.cloud.databricks.com
export ZEROBUS_SERVER_ENDPOINT=""
# Workspace URL, e.g. https://dbc-xxxx.cloud.databricks.com  (Azure: https://adb-xxxx.azuredatabricks.net)
export DATABRICKS_WORKSPACE_URL=""
# Target managed Delta table (three-part name)
export ZEROBUS_TABLE_NAME="catalog.schema.table"
# Service principal OAuth credentials (needs MODIFY + SELECT on the table)
export DATABRICKS_CLIENT_ID=""
export DATABRICKS_CLIENT_SECRET=""
