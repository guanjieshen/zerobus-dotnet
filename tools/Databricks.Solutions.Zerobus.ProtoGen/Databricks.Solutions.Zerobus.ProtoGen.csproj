<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Databricks.Solutions.Zerobus.ProtoGen</RootNamespace>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!-- Installable as a dotnet tool: `dotnet tool install ... ` then `zerobus-generate-proto ...` -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>zerobus-generate-proto</ToolCommandName>
    <PackageId>Databricks.Solutions.Zerobus.ProtoGen</PackageId>
    <Description>CLI that generates a .proto from a Unity Catalog table for Databricks Zerobus ingestion.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>

    <!-- Self-contained: opt out of the repo's central package management. -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <MinVerTagPrefix>v</MinVerTagPrefix>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" Version="6.0.0" PrivateAssets="All" />
  </ItemGroup>

</Project>
