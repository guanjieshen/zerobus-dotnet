<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0;netstandard2.1</TargetFrameworks>
    <RootNamespace>Databricks.Solutions.Zerobus</RootNamespace>
    <AssemblyName>Databricks.Solutions.Zerobus.Sdk</AssemblyName>

    <!-- NuGet package metadata -->
    <PackageId>Databricks.Solutions.Zerobus.Sdk</PackageId>
    <Authors>guanjieshen</Authors>
    <Description>Pure-managed .NET client library for Databricks Zerobus Ingest. Stream records directly into Unity Catalog Delta tables over gRPC.</Description>
    <PackageTags>databricks;zerobus;ingest;grpc;streaming;delta;unity-catalog</PackageTags>
    <PackageProjectUrl>https://github.com/guanjieshen/zerobus-dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/guanjieshen/zerobus-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Reproducible, debuggable packages -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Deterministic>true</Deterministic>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Tag-driven version: a `v1.2.3` git tag produces package version 1.2.3 -->
    <MinVerTagPrefix>v</MinVerTagPrefix>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- Compile the vendored wire contract into an INTERNAL gRPC client only.
         The hand-written async API in this assembly is the only public surface. -->
    <Protobuf Include="Protos/zerobus_service.proto"
              GrpcServices="Client"
              ProtoRoot="Protos"
              Access="Internal" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.Net.Client" />
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Tools" PrivateAssets="All" />
    <!-- Build-time only: do not flow to consumers -->
    <PackageReference Include="MinVer" PrivateAssets="All" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>

  <!-- These are in-box on net8.0; the netstandard2.1 target needs the packages. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
    <PackageReference Include="System.Threading.Channels" />
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Databricks.Solutions.Zerobus.Sdk.Tests" />
  </ItemGroup>

</Project>
